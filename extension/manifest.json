{
  "manifest_version": 3,
  "name": "MioWeave · Local Tools",
  "version": "0.0.20",
  "description": "Weave MioDesk local tools into supported web chats with clear controls and permissions.",
  "icons": {
    "16": "icons/mioweave-16.png",
    "48": "icons/mioweave-48.png",
    "128": "icons/mioweave-128.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:8790/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://chat.deepseek.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {"resources": ["icons/mioweave-small-48.png"], "matches": ["https://chat.deepseek.com/*"]}
  ],
  "options_page": "options.html"
}
